{
  "name": "@backblaze-labs/b2-sdk",
  "version": "0.6.0",
  "description": "The official Backblaze B2 Cloud Storage SDK for TypeScript and JavaScript",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.3.0"
  },
  "packageManager": "pnpm@11.1.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./raw": {
      "import": {
        "types": "./dist/raw/index.d.ts",
        "default": "./dist/raw/index.js"
      },
      "require": {
        "types": "./dist/raw/index.d.cts",
        "default": "./dist/raw/index.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors/index.d.ts",
        "default": "./dist/errors/index.js"
      },
      "require": {
        "types": "./dist/errors/index.d.cts",
        "default": "./dist/errors/index.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth/index.d.ts",
        "default": "./dist/auth/index.js"
      },
      "require": {
        "types": "./dist/auth/index.d.cts",
        "default": "./dist/auth/index.cjs"
      }
    },
    "./auth/file": {
      "import": {
        "types": "./dist/auth/file.d.ts",
        "default": "./dist/auth/file.js"
      },
      "require": {
        "types": "./dist/auth/file.d.cts",
        "default": "./dist/auth/file.cjs"
      }
    },
    "./partner": {
      "import": {
        "types": "./dist/partner/index.d.ts",
        "default": "./dist/partner/index.js"
      },
      "require": {
        "types": "./dist/partner/index.d.cts",
        "default": "./dist/partner/index.cjs"
      }
    },
    "./backup": {
      "import": {
        "types": "./dist/backup/index.d.ts",
        "default": "./dist/backup/index.js"
      },
      "require": {
        "types": "./dist/backup/index.d.cts",
        "default": "./dist/backup/index.cjs"
      }
    },
    "./streams": {
      "import": {
        "types": "./dist/streams/index.d.ts",
        "default": "./dist/streams/index.js"
      },
      "require": {
        "types": "./dist/streams/index.d.cts",
        "default": "./dist/streams/index.cjs"
      }
    },
    "./sync": {
      "import": {
        "types": "./dist/sync/index.d.ts",
        "default": "./dist/sync/index.js"
      },
      "require": {
        "types": "./dist/sync/index.d.cts",
        "default": "./dist/sync/index.cjs"
      }
    },
    "./simulator": {
      "import": {
        "types": "./dist/simulator/index.d.ts",
        "default": "./dist/simulator/index.js"
      },
      "require": {
        "types": "./dist/simulator/index.d.cts",
        "default": "./dist/simulator/index.cjs"
      }
    },
    "./notifications": {
      "import": {
        "types": "./dist/notifications/index.d.ts",
        "default": "./dist/notifications/index.js"
      },
      "require": {
        "types": "./dist/notifications/index.d.cts",
        "default": "./dist/notifications/index.cjs"
      }
    },
    "./s3": {
      "import": {
        "types": "./dist/s3/index.d.ts",
        "default": "./dist/s3/index.js"
      },
      "require": {
        "types": "./dist/s3/index.d.cts",
        "default": "./dist/s3/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "vite build && node scripts/build-cts-types.mjs",
    "build:release": "node scripts/build-release-artifact.mjs",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:all": "vitest run && vitest run --config vitest.slow.config.ts",
    "test:known-defects": "pnpm run build && vitest run --config vitest.known-defects.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:integration": "vitest run --config vitest.integration.ts",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "lint:docs": "eslint src/ --no-warn-ignored",
    "lint:docs:fix": "eslint src/ --fix --no-warn-ignored",
    "lint:spelling": "cspell --no-progress --gitignore \"src/**/*.ts\" \"examples/**/*.ts\" \"examples/**/*.md\" \"docs/**/*.md\" \"*.md\" \".changes/unreleased/*.yaml\"",
    "audit:deps": "node scripts/audit-dependencies.mjs",
    "test:qk-selection": "node --test scripts/select-qk-checks.test.mjs",
    "test:audit:deps": "node --test scripts/audit-dependencies.test.mjs",
    "test:sdkharness": "node --test \".sdkharness/tests/unit/*.test.cjs\"",
    "test:release-channel": "node --test scripts/verify-release-channel.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit -p examples/tsconfig.json",
    "typecheck:known-defects": "tsc --noEmit -p tests/known-defects/tsconfig.json",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "clean": "rm -rf dist api-docs",
    "changelog:new": "changie new",
    "changelog:merge": "changie merge",
    "changelog:check": "node scripts/verify-changelog.mjs",
    "test:release-policy": "node --test scripts/changelog-version.test.mjs scripts/release-policy.test.mjs scripts/release-workflow-policy.test.mjs",
    "release:security": "node scripts/release-security-check.mjs",
    "release:milestone": "node scripts/verify-release-milestone.mjs",
    "release:tag": "node scripts/verify-release-tag.mjs",
    "version": "node scripts/changelog-version.mjs && git add -A CHANGELOG.md .changes",
    "review:test": "node --test scripts/review-risk.test.mjs scripts/review-metrics.test.mjs",
    "review:metrics": "node scripts/review-metrics.mjs",
    "prepublishOnly": "pnpm run clean && pnpm run build:release && pnpm run verify:release-channel -- --published && pnpm run verify:metadata && pnpm run verify:release && pnpm run verify:exports",
    "verify:metadata": "node --test scripts/verify-package-metadata.test.mjs && node scripts/verify-package-metadata.mjs",
    "verify:release": "pnpm run changelog:check && pnpm run test:release-policy && node scripts/verify-release-workflow.mjs",
    "verify:release-channel": "node scripts/verify-release-channel.mjs",
    "verify:ci-docs-filter": "node --test scripts/verify-docs-only-classifier.test.mjs",
    "verify:docs-consistency": "node --test scripts/verify-docs-consistency.test.mjs scripts/verify-changelog-migration.test.mjs scripts/verify-use-b2-sdk.test.mjs scripts/docs-front-matter.test.mjs scripts/verify-llms-txt.test.mjs",
    "verify:exports": "node scripts/verify-package-exports.mjs",
    "verify:release-workflow": "node scripts/verify-release-workflow.mjs",
    "smoke:published": "node scripts/smoke-published-package.mjs",
    "test:smoke-published": "node --test scripts/smoke-published-package.test.mjs",
    "verify": "pnpm run lint && pnpm run lint:docs && pnpm run lint:spelling && pnpm run review:test && pnpm run typecheck && pnpm run typecheck:examples && pnpm run typecheck:known-defects && pnpm run test:qk-selection && pnpm run test:audit:deps && pnpm run test:sdkharness && pnpm run test && pnpm run test:release-channel && pnpm run build && pnpm run verify:release-channel && pnpm run docs && pnpm run verify:metadata && pnpm run verify:release && pnpm run verify:ci-docs-filter && pnpm run verify:docs-consistency && pnpm run verify:exports"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@eslint/js": "^10.0.1",
    "@microsoft/tsdoc-config": "^0.18.3",
    "@types/node": "^26.6.6",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "changie": "1.26.0",
    "cspell": "^10.5.1",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-tsdoc": "^0.5.4",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "keywords": [
    "backblaze",
    "b2",
    "cloud-storage",
    "object-storage",
    "s3",
    "upload",
    "download",
    "multipart",
    "streaming",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/backblaze-labs/b2-sdk-typescript.git"
  },
  "author": "Backblaze, Inc.",
  "homepage": "https://github.com/backblaze-labs/b2-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/backblaze-labs/b2-sdk-typescript/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
