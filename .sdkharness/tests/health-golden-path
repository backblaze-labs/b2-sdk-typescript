#!/usr/bin/env bash
# Repository-owned HTTP customer lifecycle. sdkharness supplies a fresh shared
# simulator, fixed fake credentials, and a pre-created bucket.
set -u

LEVEL="${SDKHARNESS_TEST_LEVEL:-health}"
SCENARIO="${SDKHARNESS_SCENARIO:-golden-path}"

run_health() {
  [ "$LEVEL" = health ] && [ "$SCENARIO" = golden-path ] || return 64
  [ -n "${SDKHARNESS_SIMULATOR_URL:-}" ] || return 65
  [ -n "${HEALTHCHECK_REALM_URL:-}" ] || return 65
  [ "$SDKHARNESS_SIMULATOR_URL" = "$HEALTHCHECK_REALM_URL" ] || return 65
  [ -n "${B2_TEST_APPLICATION_KEY_ID:-}" ] || return 65
  [ -n "${B2_TEST_APPLICATION_KEY:-}" ] || return 65
  [ -n "${B2_BUCKET_NAME:-}" ] || return 65

  node -e '
const target = new URL(process.argv[1]);
if (
  target.protocol !== "http:" ||
  (target.hostname !== "127.0.0.1" && target.hostname !== "[::1]") ||
  target.port === "" ||
  target.username !== "" ||
  target.password !== "" ||
  target.pathname !== "/" ||
  target.search !== "" ||
  target.hash !== ""
) {
  process.exit(1);
}' "$SDKHARNESS_SIMULATOR_URL" || return 65

  pnpm build || return 1

  node --input-type=module <<'NODE'
import { randomUUID } from 'node:crypto'
import { B2Client, BufferSource } from '@backblaze-labs/b2-sdk'

const realm = process.env.SDKHARNESS_SIMULATOR_URL
const applicationKeyId = process.env.B2_TEST_APPLICATION_KEY_ID
const applicationKey = process.env.B2_TEST_APPLICATION_KEY
const bucketName = process.env.B2_BUCKET_NAME

const client = new B2Client({
  applicationKeyId,
  applicationKey,
  realm,
  userAgent: 'b2-sdk-typescript-repository-health',
  allowedHostSuffixes: [],
})

const objectName = `sdkharness-health-check/${randomUUID()}.txt`
const expected = new TextEncoder().encode(`b2-sdk-typescript health check ${objectName}`)
let object
let uploadedFileId

async function bytes(download) {
  if (download instanceof Uint8Array) return download
  if (download instanceof ArrayBuffer) return new Uint8Array(download)
  if (download?.body && typeof download.body.getReader === 'function') {
    const reader = download.body.getReader()
    const chunks = []
    let length = 0
    for (;;) {
      const { done, value } = await reader.read()
      if (done) break
      chunks.push(value)
      length += value.length
    }
    const result = new Uint8Array(length)
    let offset = 0
    for (const chunk of chunks) {
      result.set(chunk, offset)
      offset += chunk.length
    }
    return result
  }
  throw new Error('download result did not contain bytes')
}

try {
  await client.authorize()
  const bucket = await client.getBucket(bucketName)
  if (!bucket) throw new Error('pre-created bucket was not found')

  object = bucket.file(objectName)
  const uploaded = await object.upload({ source: new BufferSource(expected) })
  uploadedFileId = uploaded.fileId

  const actual = await bytes(await object.download())
  if (
    actual.length !== expected.length ||
    actual.some((byte, index) => byte !== expected[index])
  ) {
    throw new Error('downloaded bytes did not match uploaded bytes')
  }

  const beforeDelete = await bucket.listFileNames({ prefix: objectName })
  if (!beforeDelete.files.some((file) => file.fileName === objectName)) {
    throw new Error('uploaded object was not listed')
  }

  await object.deleteVersion(uploadedFileId)
  uploadedFileId = undefined

  const afterDelete = await bucket.listFileNames({ prefix: objectName })
  if (afterDelete.files.some((file) => file.fileName === objectName)) {
    throw new Error('deleted object was still listed')
  }
} finally {
  if (object && uploadedFileId) {
    await object.deleteVersion(uploadedFileId).catch(() => undefined)
  }
}
NODE
}

if run_health; then
  printf 'SDKHARNESS_RESULT\t%s\t%s\tPASS\t-\n' "$LEVEL" "$SCENARIO"
else
  code=$?
  printf 'SDKHARNESS_RESULT\t%s\t%s\tFAIL\trepository HTTP health failed with exit %s\n' \
    "$LEVEL" "$SCENARIO" "$code"
  exit "$code"
fi
