#!/usr/bin/env bash
set -u

LEVEL=resilience
SCENARIO="${SDKHARNESS_SCENARIO:-}"
HERE="$(cd "$(dirname "$0")" && pwd -P)"
. "$HERE/lib/contract.sh"
sdkharness_scrub_proxy_env
result() { printf 'SDKHARNESS_RESULT\t%s\t%s\t%s\t%s\n' "$LEVEL" "$SCENARIO" "$1" "$2"; }

[ "${SDKHARNESS_TEST_LEVEL:-}" = "$LEVEL" ] \
  || { result FAIL 'configuration: unexpected test level'; exit 1; }
case "$SCENARIO" in ''|*[!A-Za-z0-9_.-]*) result FAIL 'configuration: invalid scenario'; exit 1 ;; esac
[ -n "${SDKHARNESS_SIMULATOR_URL:-}" ] && sdkharness_valid_loopback_origin "$SDKHARNESS_SIMULATOR_URL" \
  && [ -n "${SDKHARNESS_SIMULATOR_CONTROL_URL:-}" ] && sdkharness_valid_loopback_origin "$SDKHARNESS_SIMULATOR_CONTROL_URL" \
  || { result FAIL 'configuration: simulator and control URLs must be IPv4 loopback HTTP origins'; exit 1; }
if [ -n "${SDKHARNESS_SIMULATOR_HTTPS_URL:-}" ] && ! sdkharness_valid_loopback_https_origin "$SDKHARNESS_SIMULATOR_HTTPS_URL"; then
  result FAIL 'configuration: simulator TLS URL must be an IPv4 loopback HTTPS origin'; exit 1
fi
check="$HERE/resilience/$SCENARIO.cjs"
[ -x "$check" ] || { result FAIL 'configuration: scenario executable is unavailable'; exit 1; }

# The checks count the simulator's whole request journal and it has no reset, so a simulator an
# earlier scenario used makes a leaf read that scenario's requests as its own (for example
# upload.cap_exceeded_403 reporting extra b2_upload_file calls). Start one --control simulator per scenario.
if ! fresh="$(node "$HERE/lib/guard.cjs" "$SDKHARNESS_SIMULATOR_CONTROL_URL" 2>/dev/null)"; then
  result FAIL "configuration: ${fresh:-cannot read the simulator journal}"; exit 1
fi

log="$(mktemp "${TMPDIR:-/tmp}/sdkharness-typescript-resilience.XXXXXX")" \
  || { result FAIL 'setup: could not create child log'; exit 1; }
trap 'rm -f "$log"' EXIT
if RESILIENCE_TARGET=simulator \
  RESILIENCE_SIMULATOR_URL="$SDKHARNESS_SIMULATOR_URL" \
  RESILIENCE_SIMULATOR_HTTPS_URL="${SDKHARNESS_SIMULATOR_HTTPS_URL:-}" \
  RESILIENCE_SIMULATOR_CA="${SDKHARNESS_SIMULATOR_CA:-}" \
  RESILIENCE_CONTROL_URL="$SDKHARNESS_SIMULATOR_CONTROL_URL" \
  "$check" >"$log" 2>&1; then child_rc=0; else child_rc=$?; fi

prefix="RESILIENCE b2-sdk-typescript $SCENARIO @"
grep -Fv "$prefix" "$log" || true
count="$(grep -Fc "$prefix" "$log" 2>/dev/null || true)"
[ "$count" = 1 ] || { result FAIL "contract: expected one standing result, got $count"; exit 1; }
verdict="$(grep -F "$prefix" "$log")"; verdict="${verdict#*: }"
case "$verdict" in
  PASS) [ "$child_rc" = 0 ] || { result FAIL "contract: PASS exited $child_rc"; exit 1; }; result PASS - ;;
  'FAIL ('*')') reason="${verdict#FAIL (}"; result FAIL "${reason%)}"; exit 1 ;;
  'COULD-NOT-RUN ('*')')
    # A leaf that reported amber but exited nonzero crashed or failed cleanup:
    # that is a FAIL, never acceptable amber evidence.
    [ "$child_rc" = 0 ] || { result FAIL "contract: COULD-NOT-RUN exited $child_rc"; exit 1; }
    reason="${verdict#COULD-NOT-RUN (}"; result SKIP "${reason%)}" ;;
  *) result FAIL 'contract: malformed standing verdict'; exit 1 ;;
esac
